# LLM Provider (rule_based | ollama | openai | anthropic | agnes)
# rule_based = no API needed (splits text by paragraphs)
# ollama = local free LLM (install Ollama, run: ollama pull llama3.2)
LLM_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
AGNES_BASE_URL=https://api.agnes.ai/v1

# TTS
EDGE_TTS_VOICE=en-US-GuyNeural
KOKORO_MODEL_PATH=

# Video Gen (mock | wan | hunyuan | ltx)
# mock = synthetic video via FFmpeg (no API keys needed)
VIDEO_PROVIDER=mock
HF_API_TOKEN=
REPLICATE_API_TOKEN=
FAL_API_KEY=

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Output
OUTPUT_DIR=output
TEMP_DIR=output/.tmp
LOG_LEVEL=INFO

# Subtitle styling
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=24
SUBTITLE_COLOR=FFFFFF
SUBTITLE_OUTLINE_COLOR=000000
SUBTITLE_OUTLINE_WIDTH=2